# Optional Openverse OAuth (server only — never expose to the Vite bundle).
# Without these, audio search uses anonymous limits (20/min, 200/day).
# Register at POST https://api.openverse.org/v1/auth_tokens/register/
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Optional override; default https://api.openverse.org/v1
# OPENVERSE_API_BASE=https://api.openverse.org/v1
